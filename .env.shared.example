# Shared runtime configuration — safe to share inside a team environment file.
# Copy to `.env.shared` (gitignored locally when customized).

PRODUCT_ID=sololakehouse
PRODUCT_DISPLAY_NAME=SoloLakehouse
PRODUCT_DOMAIN=financial_markets
ENVIRONMENT=local
RUNTIME_VERSION=slh-v2.6.1
PROMOTION_STAGE=dev
ROLLBACK_TARGET_TAG=v2.6.1
COMPOSE_PROJECT_NAME=sololakehouse
TRINO_USER=sololakehouse

HIVE_METASTORE_URI=thrift://localhost:9083
ICEBERG_CATALOG_BACKEND=hive
ICEBERG_CATALOG_NAME=hive
ICEBERG_REST_URI=
ICEBERG_REST_OAUTH2_URI=
ICEBERG_REST_SCOPE=

MINIO_ENDPOINT=localhost:9000
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
PG_PORT=5432
S3_ENDPOINT=http://minio:9000
MLFLOW_S3_ENDPOINT_URL=http://minio:9000
MLFLOW_TRACKING_URI=http://localhost:5000

DATA_BUCKET=sololakehouse
BUCKET_NAME=sololakehouse
AUDIT_BUCKET=sololakehouse-audit
AUDIT_OBJECT_LOCK_MODE=GOVERNANCE
AUDIT_OBJECT_LOCK_RETENTION=2555d
MLFLOW_ARTIFACT_BUCKET=mlflow-artifacts
MLFLOW_ARTIFACT_ROOT=s3://mlflow-artifacts/
WAREHOUSE_URI=s3a://sololakehouse/warehouse/

TRINO_URL=http://localhost:8080
OPENMETADATA_URL=http://localhost:8585
OPENMETADATA_ADMIN_PRINCIPAL=admin
OPENMETADATA_PORT=8585
OPENMETADATA_ADMIN_PORT=8586
OPENMETADATA_TRINO_SERVICE_NAME=sololakehouse-trino
SUPERSET_URL=http://localhost:8088

SUPERSET_DB_NAME=superset_metadata
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_EMAIL=admin@sololakehouse.local
SUPERSET_ADMIN_FIRSTNAME=Solo
SUPERSET_ADMIN_LASTNAME=Lakehouse
SUPERSET_TRINO_ICEBERG_DB_NAME=trino_iceberg_gold
SUPERSET_TRINO_ICEBERG_URI=
SUPERSET_TRINO_HIVE_DB_NAME=trino_hive_default
SUPERSET_TRINO_HIVE_URI=
