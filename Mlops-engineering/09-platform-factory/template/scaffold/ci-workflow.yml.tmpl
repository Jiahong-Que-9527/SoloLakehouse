# Scoped CI for the {{workload_id}} workload, mirroring the charging-forecast
# workflow shape (test + optional image job). Install at
# .github/workflows/{{workload_id}}.yml and scope the paths to the
# workload's directory. The image job is optional: enable it from the
# milestone that containers the workload.

name: {{workload_id}}

on:
  push:
    branches: [main]
    paths:
      - 'Mlops-engineering/{{workload_id}}/**'
      - '.github/workflows/{{workload_id}}.yml'
  pull_request:
    paths:
      - 'Mlops-engineering/{{workload_id}}/**'
      - '.github/workflows/{{workload_id}}.yml'
  workflow_dispatch:

permissions:
  contents: read

jobs:
  test:
    runs-on: ubuntu-latest
    defaults:
      run:
        working-directory: Mlops-engineering/{{workload_id}}
    steps:
      - uses: actions/checkout@v5
      - uses: astral-sh/setup-uv@68559e99cc807c1eb7e9238fd43a15bba460eec2 # v10.3.3
        with:
          version: '0.13.9'
          python-version: '3.12'
      - run: uv sync --locked
      - run: uv run --locked ruff check .
      - run: uv run --locked ruff format --check .
      - run: uv run --locked pytest
