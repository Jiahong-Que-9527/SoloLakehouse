# Data-engineering local runtime state (raw DuckDB, generated payloads, checkpoints,
# live-refresh downloads). Locked fixtures under reference-warehouse/fixtures/ stay in Git;
# data/ itself stays in Git only for the .gitkeep that gives sqlfluff's dbt-templater
# connection a parent directory in fresh checkouts.
Data-engineering/reference-warehouse/data/*
!Data-engineering/reference-warehouse/data/.gitkeep
Data-engineering/reference-warehouse/dbt_project/target/
Data-engineering/reference-warehouse/dbt_project/dbt_packages/
!Data-engineering/reference-warehouse/fixtures/*.csv

# OS
.DS_Store
Thumbs.db

# Local agent CLI state
.zcode/

# dbt local artifacts
Data-engineering/reference-warehouse/dbt_project/.user.yml
Data-engineering/reference-warehouse/dbt_project/logs/
Data-engineering/reference-warehouse/airflow/.airflow-local/

# template/example domains (E08): local warehouses and dbt build artifacts
Data-engineering/reference-warehouse/examples/**/*.duckdb
Data-engineering/reference-warehouse/examples/**/target/
Data-engineering/reference-warehouse/examples/**/logs/
Data-engineering/reference-warehouse/examples/**/.user.yml
Data-engineering/reference-warehouse/template/**/target/
# the example/template seeds are deliberate starter data — must be tracked
!Data-engineering/reference-warehouse/examples/**/*.csv
!Data-engineering/reference-warehouse/template/**/*.csv
