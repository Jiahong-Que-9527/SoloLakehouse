# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
dist/
build/
.coverage
htmlcov/
.ipynb_checkpoints/

# Secrets and local environment.
# Keep committed templates such as .env.example.
.env
.env.*
!.env.example
token.json
login-url.txt
*.pem
*.key
credentials*.json

# Datasets and local state. uv.lock stays tracked.
# Source tables stay on disk. Fixture notes such as fixtures/README.md stay tracked.
*.parquet
*.duckdb
*.sqlite
*.sqlite3
*.db
*.csv
*.tsv
*.xlsx
*.xls
*.xml
*.log

# Packaged synthetic samples are generated fixtures in SMARD export shape,
# not raw source data; they ship inside the package for the cloud sample mode.
!gcp/01-european-energy-pipeline/src/energy_pipeline/data/*.csv

# Versioned ECB sample fixtures for Databricks D01 (small fixed synthetic/public slices).
!databricks/01-ecb-delta-lakehouse/fixtures/*.csv
!databricks/02-financial-etl-automation/fixtures/fx_conflict.csv

# Local editor and agent state. The shared Cursor rule stays tracked.
.cursor/*
!.cursor/rules/
.claude/

# Terraform
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*

# Local consulting notes. Keep designs in project docs/.
chatgpt-consulting*.md


