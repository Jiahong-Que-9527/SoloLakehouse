# Secret runtime configuration — never commit `.env.secrets`.
# Copy to `.env.secrets` (gitignored) and rotate values for non-local use.

MINIO_ROOT_USER=sololakehouse
MINIO_ROOT_PASSWORD=sololakehouse123
POSTGRES_USER=postgres
# Generate a unique value, e.g. `openssl rand -hex 32`; never reuse a default.
POSTGRES_PASSWORD=
S3_ACCESS_KEY=sololakehouse
S3_SECRET_KEY=sololakehouse123
AWS_ACCESS_KEY_ID=sololakehouse
AWS_SECRET_ACCESS_KEY=sololakehouse123

# Optional: git commit stamped into evidence manifests when unset in Makefile.
GIT_COMMIT=

# OAuth / REST catalog credentials (optional Polaris profile).
ICEBERG_REST_CREDENTIAL=

# OpenMetadata bearer token for lineage evidence (local only).
OPENMETADATA_AUTH_TOKEN=

# OpenMetadata's own MySQL root account (om-mysql). Generate a unique value;
# never reuse a default. Note this only covers the root account -- the
# 'openmetadata_user'/'airflow_user' app accounts are currently fixed by the
# vendor image's init script regardless of any env var (see
# docker/docker-compose.openmetadata.yml).
OPENMETADATA_MYSQL_ROOT_PASSWORD=

SUPERSET_SECRET_KEY=sololakehouse-superset-secret-key-change-me
# Generate a unique value; never reuse the OpenMetadata/Superset upstream default.
SUPERSET_ADMIN_PASSWORD=

# Alpha Vantage API key for live EWG (German equity proxy) ingestion.
# CI sets DAX_FIXTURE_PATH instead so compose-demo never calls Alpha Vantage live.
ALPHA_VANTAGE_API_KEY=

# Optional: override EWG collector input (CI uses tests/fixtures/alpha_vantage_ewg_daily.json).
DAX_FIXTURE_PATH=

# Pipeline completion email (Dagster run_status_sensor). Comma-separate multiple
# recipients in PIPELINE_NOTIFY_EMAIL_TO. Gmail example below uses an app password.
PIPELINE_NOTIFY_EMAIL_TO=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
